  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import seaborn as sns\n",
    "import shap\n",
    "\n",
    "from sklearn.datasets import load_iris\n",
    "from sklearn.decomposition import PCA\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score,\n",
    "    auc,\n",
    "    classification_report,\n",
    "    confusion_matrix,\n",
    "    f1_score,\n",
    "    precision_score,\n",
    "    recall_score,\n",
    "    roc_curve,\n",
    ")\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.preprocessing import LabelBinarizer, StandardScaler\n",
    "from sklearn.svm import SVC\n",
    "\n",
    "plt.style.use(\"seaborn-v0_8-whitegrid\")\n",
    "plt.rcParams[\"font.family\"] = \"sans-serif\"\n",
    "plt.rcParams[\"font.size\"] = 10"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Caricamento e Preprocessing dei Dati"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"=== 1. Caricamento Dataset Iris ===\")\n",
    "iris = load_iris()\n",
    "X = pd.DataFrame(iris.data, columns=iris.feature_names)\n",
    "y = iris.target\n",
    "class_names = iris.target_names\n",
    "\n",
    "print(f\"Forma del dataset: {X.shape}\")\n",
    "print(f\"Classi presenti: {list(class_names)}\\n\")\n",
    "\n",
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(X)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Analisi delle Componenti Principali (PCA)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"=== 2. Esecuzione Algoritmo PCA ===\")\n",
    "pca = PCA(n_components=2)\n",
    "X_pca = pca.fit_transform(X_scaled)\n",
    "\n",
    "print(f\"Varianza spiegata per componente: {pca.explained_variance_ratio_ * 100}\")\n",
    "print(f\"Varianza spiegata cumulativa: {np.sum(pca.explained_variance_ratio_) * 100:.2f}%\\n\")\n",
    "\n",
    "plt.figure(figsize=(8, 6))\n",
    "colors = [\"#2b5c8f\", \"#d95f02\", \"#7570b3\"]\n",
    "for i, color, target_name in zip([0, 1, 2], colors, class_names):\n",
    "    plt.scatter(\n",
    "        X_pca[y == i, 0],\n",
    "        X_pca[y == i, 1],\n",
    "        color=color,\n",
    "        alpha=0.8,\n",
    "        lw=2,\n",
    "        label=target_name,\n",
    "        edgecolor=\"k\",\n",
    "        s=70,\n",
    "    )\n",
    "\n",
    "plt.title(\"PCA Proiezione 2D Dataset Iris\", fontsize=14, fontweight=\"bold\", pad=15)\n",
    "plt.xlabel(f\"Componente Principale 1 ({pca.explained_variance_ratio_[0]*100:.1f}%)\")\n",
    "plt.ylabel(f\"Componente Principale 2 ({pca.explained_variance_ratio_[1]*100:.1f}%)\")\n",
    "plt.legend(loc=\"best\", shadow=True)\n",
    "plt.tight_layout()\n",
    "plt.savefig(\